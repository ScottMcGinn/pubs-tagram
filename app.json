{
  "expo": {
    "name": "Pubs-tagram",
    "slug": "pubs-tagram",
    "version": "1.0.0-beta.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pubstagram.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.pubstagram.app",
      "minSdkVersion": 21,
      "targetSdkVersion": 35,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pubs-tagram to access your photos to add pub pictures.",
          "cameraPermission": "Allow Pubs-tagram to use your camera to take pub pictures."
        }
      ]
    ],
    "sdkVersion": "54.0.0",
    "extra": {
      "eas": {
        "projectId": "be0193c6-e28e-4811-86a1-9cfc5a14f412"
      }
    }
  }
}
